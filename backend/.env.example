# Sao chép thành .env và chỉnh sửa.
# Dev nhanh dùng SQLite:
DATABASE_URL=sqlite:///./dev.db
# Production / Docker dùng Postgres:
# DATABASE_URL=postgresql+psycopg2://obe:obe@localhost:5432/obe

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# API AI giờ do Admin cấu hình trong giao diện (/admin/ai), lưu trong CSDL,
# hỗ trợ cả Claude (anthropic) lẫn OpenAI. Hai biến dưới CHỈ là fallback tùy chọn
# nếu chưa có key nào trong CSDL (để tương thích ngược):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
